{
	"manifest_version": 3,
	"name": "Imagus Reborn MD (Firefox)",
	"version": "2026.1.31",
	"description": "__MSG_APP_DESCRIPTION__",
	"default_locale": "en",
	"homepage_url": "https://www.reddit.com/r/Imagus",
	"browser_specific_settings": {
		"gecko": {
			"id": "{7653b5cb-d76d-442f-a98f-f3c83a118cf4}",
			"strict_min_version": "128.0"
		}
	},
	"icons": {
		"128": "common/img/icon.png"
	},
	"action": {
		"default_popup": "options/popup.html"
	},
	"permissions": [
		"alarms",
		"downloads",
		"history",
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"incognito": "spanning",
	"background": {
		"scripts": [
			"background/service.js"
		]
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"common/app.js",
				"content/content.js"
			],
			"run_at": "document_idle",
			"all_frames": true
		}
	],
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	}
}