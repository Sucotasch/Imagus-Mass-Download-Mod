{
	"manifest_version": 3,
	"name": "Imagus Mass Download Mod (Firefox)",
	"version": "2026.1.31.2",
	"description": "__MSG_APP_DESCRIPTION__",
	"default_locale": "en",
	"homepage_url": "https://www.reddit.com/r/Imagus",
	"icons": {
		"128": "common/img/icon.png"
	},
	"action": {
		"default_popup": "options/popup.html"
	},
	"permissions": [
		"alarms",
		"downloads",
		"history",
		"storage"
	],
	"optional_permissions": [
		"userScripts"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"scripts": [
			"background/service.js"
		]
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "imagus-mass-download-mod@sucot.net",
			"strict_min_version": "121.0"
		}
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	}
}